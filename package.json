{
  "name": "math-note-app",
  "version": "1.0.0",
  "private": true,
  "description": "数学笔记应用 - 支持PDF/图片/文本编辑",
  "scripts": {
    "postinstall": "node scripts/patch-share.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --environment jsdom",
    "preview": "vite preview",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^5.6.1",
    "@capacitor/app": "^5.0.8",
    "@capacitor/browser": "^5.2.1",
    "@capacitor/core": "^5.6.1",
    "@capacitor/filesystem": "^5.0.7",
    "@capacitor/share": "^5.0.8",
    "idb": "^7.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.8",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  }
}
